DATABASE_URL=postgresql://openpims:openpims@localhost:5432/openpims

# mock stays local. live calls Tencent Cloud SMS SendSms.
TENCENT_SMS_MODE=mock
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Stripe secret key. Without it, card checkout reports that payments are not configured.
STRIPE_SECRET_KEY=

# WeChat Pay customer-code charges. API key is the APIv2 key.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# Alipay customer-code charges. The private key is a PEM; escaped newlines are accepted.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
