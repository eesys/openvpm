DATABASE_URL=postgresql://openpims:openpims@localhost:5432/openpims

# Messaging provider. Unset uses Telnyx when TELNYX_API_KEY is present, else a
# console fallback that logs instead of sending (local dev / CI).
MESSAGING_PROVIDER=
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=

# Stripe secret key. Without it, card checkout reports that payments are not configured.
STRIPE_SECRET_KEY=

# Hosted billing. Unset = self-host: usage is never metered and everything stays unlocked.
HOSTED_BILLING_ENABLED=
